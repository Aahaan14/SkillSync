# Database
DATABASE_URL=postgresql+asyncpg://career_copilot:changeme_in_production@localhost:5432/career_copilot
REDIS_URL=redis://localhost:6379/0

# SerpApi
SERPAPI_API_KEY=

# AI Provider (grok | openai | gemini | anthropic)
AI_PROVIDER=grok
GROK_API_KEY=
GROK_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Authentication — set stable secrets so tokens survive backend restarts
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies — false for local HTTP; true behind HTTPS
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# CORS (chrome-extension origins are also allowed via regex)
CORS_ORIGINS=http://localhost:3000

# Server
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Rate Limiting (requests / window)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_ANALYSIS=10/hour
RATE_LIMIT_MARKET_SEARCH=20/hour

# SerpApi Cost Control
SERPAPI_MAX_QUERIES_PER_ANALYSIS=5
SERPAPI_CACHE_TTL_HOURS=24

# AI Cost Control
AI_MAX_INPUT_TOKENS=4000
AI_MAX_OUTPUT_TOKENS=2000
