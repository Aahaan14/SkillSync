{
  "manifest_version": 3,
  "name": "SkillSync - Career Copilot",
  "version": "1.1.0",
  "description": "Analyze your professional profile against current market demand using live web data and AI.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.linkedin.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "SkillSync"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.linkedin.com/in/*"],
      "js": ["content_linkedin.js"]
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://*.linkedin.com/*"],
      "js": ["content_generic.js"]
    }
  ]
}
