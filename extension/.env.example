# Backend ORIGIN (no trailing "/api"; it is appended automatically).
# Add the same origin to host_permissions in public/manifest.json if it is not localhost.
VITE_API_URL=http://localhost:8000

# Web dashboard origin, used for the "View Full Web Dashboard" link.
VITE_WEB_URL=http://localhost:3000

# VITE_* values are bundled into the extension and visible to every user.
# NEVER put SerpApi, AI-provider or JWT secrets here: the extension only talks
# to the SkillSync backend.
